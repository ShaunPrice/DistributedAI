# Copy to .env only when overriding the loopback defaults. Never add secrets here.
PORT=8090
PUBLIC_URL=http://127.0.0.1:8090/mcp
ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# For internet deployment set DOMAIN and use compose.internet.yaml:
# DOMAIN=memory.example.org
# PUBLIC_URL=https://memory.example.org/mcp
# ALLOWED_HOSTS=memory.example.org,127.0.0.1:*,localhost:*
# Optional external OAuth resource server configuration:
# OIDC_ISSUER=https://identity.example.org/realms/example
# OIDC_JWKS_URL=https://identity.example.org/realms/example/protocol/openid-connect/certs

# Optional provider-hosted passkey-capable browser login (see docs/IDENTITY.md).
LOGIN_MODE=token
LOGIN_PROVIDER=Organisation
LOGIN_ISSUER=
LOGIN_CLIENT_ID=
# Client secret and exact subject mapping are mounted from .secrets by Compose.

# Optional metering and payment-provider integration; see docs/BILLING.md.
BILLING_ENABLED=false

# Optional installation support defaults use .secrets/support_defaults.json.
# Generate with scripts/setup.py --generate-only --solution-support-url https://support.example.org
# Admin-page settings take precedence over installation defaults.
